{
  "schema_version": "2.0",
  "protocol": "wifi",
  "loader": "mapped_csv",
  "interval": {
    "nominal_s": 0.1,
    "min_rate_s": 0.01,
    "gap_s": 1
  },
  "identity": {
    "timestamp": "timestamp",
    "device": "device_id",
    "session": "session_id",
    "scenario": "scenario",
    "link": "link_id",
    "pair": "pair_id"
  },
  "metrics": {
    "throughput_kbps": {
      "source": "app_rx_bytes_total",
      "kind": "cumulative_bytes",
      "unit": "byte",
      "scale": 0.008,
      "description": "接收端应用字节累积计数；每设备/会话/链路差分，负差视为重置"
    },
    "rssi_valid": {
      "source": "rssi_dbm",
      "kind": "gauge",
      "unit": "dBm"
    },
    "phy_rate_mbps": {
      "source": "phy_rate_mbps",
      "kind": "gauge",
      "unit": "Mbps"
    },
    "channel_busy_pct": {
      "source": "channel_busy_pct",
      "kind": "gauge",
      "unit": "percent"
    },
    "retry_count": {
      "source": "tx_retries_total",
      "kind": "cumulative_count",
      "unit": "count"
    },
    "failure_count": {
      "source": "tx_failed_total",
      "kind": "cumulative_count",
      "unit": "count"
    },
    "latency_ms": {
      "source": "app_latency_ms",
      "kind": "gauge",
      "unit": "ms"
    }
  },
  "default_outcome": "throughput_kbps",
  "causal_candidates": [
    "rssi_valid",
    "channel_busy_pct",
    "phy_rate_mbps",
    "retry_count"
  ],
  "matched_covariates": [
    "scenario",
    "pair_id",
    "firmware",
    "band_ghz",
    "channel_width_mhz",
    "offered_load_mbps"
  ],
  "notes": [
    "app_rx_bytes_total必须是接收端应用字节口径；若只有驱动tx_bytes必须改指标标签并确认语义",
    "phy_rate_mbps不是应用吞吐量",
    "驱动的tx_retries/tx_failed不等于SLE超时放弃包",
    "不能自动赋予失败计数音频卡顿含义",
    "计数器重置丢弃该差分；位宽未知不做wrap补偿",
    "配对设计仍需要独立设备复制，pair_id不是随机化证明"
  ],
  "diagnostic_roles": {
    "signal": [
      "rssi_valid"
    ],
    "interference": [
      "channel_busy_pct"
    ],
    "control": [
      "phy_rate_mbps"
    ],
    "scheduler": []
  },
  "diagnostic_match_fields": [
    "firmware",
    "band_ghz",
    "channel_width_mhz",
    "offered_load_mbps"
  ],
  "diagnostic_thresholds": {
    "rssi_valid": 3,
    "interf_avg": 3,
    "weighted_interf_avg": 3,
    "channel_busy_pct": 10,
    "ack_ratio": 0.1,
    "delay_proxy_ms": 20,
    "latency_ms": 3,
    "stall_flag": 0.1,
    "throughput_kbps": 1,
    "bitrate": 1,
    "pwrlev": 1,
    "phy_rate_mbps": 10,
    "abnormal_cnt": 0.5,
    "cancel_cnt": 0.5,
    "abort_cnt": 0.5,
    "retry_count": 0.5
  },
  "threshold_note": "这些是原始单位的探索筛选下限，结合参考MAD使用；不是物理标准、SLA或显著性检验。"
}
